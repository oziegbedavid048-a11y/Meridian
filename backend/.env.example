# Copy this file to ".env" in the same folder and fill it in. ".env" is never
# committed. Real environment variables (from your host) override this file.

# ---- Local development: uncomment the next line, nothing else is needed ----
# DJANGO_DEBUG=1

# ---- Production (required) ----
# A long random value. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Your real domain names, comma separated. Never "*".
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# The https origins your site is served from.
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# ---- Production: HTTPS and proxies ----
# Set to 1 only when a proxy or load balancer YOU control terminates HTTPS and
# sets X-Forwarded-Proto. Never set it if the app is reachable directly.
DJANGO_BEHIND_PROXY=1
# How many proxies / load balancers sit in front of the app (0 if none).
DJANGO_TRUSTED_PROXY_COUNT=1
# Turn off only if your proxy already redirects http to https.
# DJANGO_SSL_REDIRECT=1

# ---- Firewall (comma separated IP addresses or ranges, empty = off) ----
# Addresses that get nothing at all:
DJANGO_BLOCKED_IPS=
# If set, ONLY these addresses can reach the site at all:
DJANGO_ALLOWED_IPS=
# If set, ONLY these addresses can reach the admin (strongly recommended):
DJANGO_ADMIN_ALLOWED_IPS=
# Move the admin away from /admin/ (keep the trailing slash off, it is added):
DJANGO_ADMIN_URL=staff-portal-change-me

# ---- Database and cache ----
# Leave the database blank to use the built-in SQLite file (fine for testing).
# Either paste the host's single link (Render: the Internal Database URL):
# DATABASE_URL=postgresql://user:password@host/dbname
# or fill in the parts:
# DJANGO_DB_NAME=zentra
# DJANGO_DB_USER=zentra
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost
# DJANGO_DB_SSLMODE=require
# Needed once more than one server process runs, so rate limits are shared:
# DJANGO_REDIS_URL=redis://localhost:6379/0

# ---- Email (sign-up codes) ----
# Zoho email REST API (works on hosts that block SMTP, such as Render's free plan).
# The send mail token from your Zoho Agent, and the API host shown next to it:
# DJANGO_ZOHO_MAIL_TOKEN=
# DJANGO_ZOHO_MAIL_HOST=cpaas.zoho.com
# Or SMTP instead:
# In development the code is shown on the sign-up page and printed in the server
# window, so nothing is needed. In production set these so real emails go out.
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_TLS=1
# DJANGO_FROM_EMAIL=Zentra Direct <no-reply@zentradirect.com>
